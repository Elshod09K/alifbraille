{
  "name": "alifbraille",
  "version": "0.1.0",
  "description": "Deterministic Uzbek Latin-to-Braille transliteration engine and tactile learning platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && esbuild src/ui/app.ts --bundle --format=esm --sourcemap --outfile=dist/bundle.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/run-browser-tests.mjs"
  },
  "keywords": [
    "braille",
    "uzbek",
    "tactile",
    "accessibility",
    "education"
  ],
  "author": "Elshod Kenjayev",
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
